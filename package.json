{
  "name": "local-game-galaxy",
  "private": true,
  "version": "1.2.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "tracker": "node scripts/start-tracker.js",
    "preview": "vite preview",
    "host": "cd server && npm start",
    "test": "vitest run",
    "check:budget": "node scripts/check-component-budget.js",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:architecture:diff": "node scripts/check-architecture.mjs --diff",
    "check:architecture:strict": "node scripts/check-architecture.mjs --strict",
    "check:duplicates": "jscpd src/ --config .jscpd.json",
    "check:lint-budget": "node scripts/check-lint-budget.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "test:scripts": "node --test scripts/pipeline/*.test.cjs scripts/lib/*.test.mjs",
    "check:docs": "node scripts/check-docs-sync.mjs",
    "check:changelog": "node scripts/changelog.mjs check",
    "changelog": "node scripts/changelog.mjs",
    "tokens": "node scripts/token-usage.mjs",
    "check:security": "node scripts/check-audit.mjs",
    "cleanup:previews": "node scripts/cleanup-cloudflare-previews.mjs",
    "prepare": "husky",
    "quality-gates": "npm run check:hygiene && npm run check:architecture:diff && npm run check:budget && npm run check:duplicates && npm run lint && npm run check:lint-budget && npm test",
    "ci:gates": "npm run check:hygiene && npm run test:scripts && npm run check:changelog && npm run check:architecture && npm run check:budget && npm run check:duplicates && npm run lint && npm run check:lint-budget && npm test",
    "build:wordle-words": "node scripts/build-wordle-words.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "react": "^19.2.0",
      "react-dom": "^19.2.0"
    }
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@hello-pangea/dnd": "18.0.1",
    "@mui/icons-material": "7.3.11",
    "@mui/lab": "7.0.1-beta.25",
    "@mui/material": "7.3.11",
    "@types/dompurify": "3.2.0",
    "bittorrent-tracker": "11.2.3",
    "bson": "7.3.3",
    "capacitor-plugin-safe-area": "5.0.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "html5-qrcode": "2.3.8",
    "i18next": "26.5.8",
    "i18next-http-backend": "4.0.5",
    "lz-string": "1.5.0",
    "mqtt": "5.16.1",
    "qrcode": "1.5.4",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.6",
    "react-router-dom": "7.18.4",
    "react-virtuoso": "4.18.19",
    "simple-peer": "9.11.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/uuid": "11.0.0",
    "@vitejs/plugin-react": "5.1.1",
    "@xmldom/xmldom": "0.9.12",
    "concurrently": "10.0.6",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jscpd": "5.4.2",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vite-plugin-node-polyfills": "0.28.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.0.5"
  }
}

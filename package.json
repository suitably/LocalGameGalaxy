{
  "name": "local-game-galaxy",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "tracker": "node scripts/start-tracker.js",
    "preview": "vite preview",
    "host": "cd server && npm start",
    "test": "vitest run",
    "check:budget": "node scripts/check-component-budget.js",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:architecture:diff": "node scripts/check-architecture.mjs --diff",
    "check:architecture:strict": "node scripts/check-architecture.mjs --strict",
    "check:duplicates": "jscpd src/ --config .jscpd.json",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "test:scripts": "node --test scripts/pipeline/*.test.cjs scripts/lib/*.test.mjs",
    "check:docs": "node scripts/check-docs-sync.mjs",
    "check:security": "npm audit --omit=dev --audit-level=high",
    "cleanup:previews": "node scripts/cleanup-cloudflare-previews.mjs",
    "prepare": "husky",
    "quality-gates": "npm run check:hygiene && npm run check:architecture:diff && npm run check:budget && npm run check:duplicates && npm run lint && npm test",
    "ci:gates": "npm run check:hygiene && npm run test:scripts && npm run check:architecture && npm run check:budget && npm run check:duplicates && npm run lint && npm test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "react": "^19.2.0",
      "react-dom": "^19.2.0"
    }
  },
  "dependencies": {
    "@capacitor/android": "8.1.0",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.1.0",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@hello-pangea/dnd": "18.0.1",
    "@mui/icons-material": "7.3.6",
    "@mui/lab": "7.0.1-beta.20",
    "@mui/material": "7.3.6",
    "@types/dompurify": "3.0.5",
    "bittorrent-tracker": "11.2.3",
    "bson": "7.3.3",
    "capacitor-plugin-safe-area": "5.0.0",
    "dexie": "4.2.1",
    "dexie-react-hooks": "4.4.0",
    "dompurify": "3.4.16",
    "fflate": "0.8.3",
    "html5-qrcode": "2.3.8",
    "i18next": "25.7.3",
    "i18next-http-backend": "4.0.0",
    "lz-string": "1.5.0",
    "mqtt": "5.15.2",
    "opensheetmusicdisplay": "1.9.9",
    "qrcode": "1.5.4",
    "qrcode.react": "4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "16.5.0",
    "react-router-dom": "7.18.4",
    "react-virtuoso": "4.18.1",
    "simple-peer": "9.11.1",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.1.0",
    "@eslint/js": "9.39.1",
    "@types/node": "24.19.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "10.0.0",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "9.2.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jscpd": "5.3.2",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.3.6",
    "vite-plugin-node-polyfills": "0.28.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}

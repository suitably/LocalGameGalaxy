{
    "name": "nexumia-server",
    "version": "1.0.0",
    "description": "Local server for Nexumia library",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "package": "pkg . --out-path dist",
        "test": "node --test"
    },
    "bin": "index.js",
    "pkg": {
        "assets": [
            "config.js",
            "public/**/*",
            "src/**/*",
            "node_modules/**/*"
        ],
        "targets": [
            "node18-linux-x64",
            "node18-win-x64",
            "node18-macos-x64"
        ]
    },
    "dependencies": {
        "@hono/node-server": "^2.1.1",
        "bittorrent-tracker": "^11.2.2",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "fast-glob": "^3.3.2",
        "helmet": "^8.1.0",
        "hono": "^4.13.5",
        "morgan": "^1.10.1",
        "multer": "^2.1.1",
        "music-metadata": "^7.14.0",
        "node-forge": "^1.3.3",
        "sanitize-filename": "^1.6.3",
        "selfsigned": "^5.5.0",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "pkg": "^5.8.1"
    }
}

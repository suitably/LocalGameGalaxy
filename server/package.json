{
  "name": "nexumia-server",
  "version": "2.0.0",
  "license": "AGPL-3.0-or-later",
  "description": "Nexumia server: companion backend for LocalGameGalaxy and its plugins (MelodiQ, tabletop, notes)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/nexumia-server.cjs",
    "package": "npm run bundle && pkg dist/nexumia-server.cjs --targets node24-linux-x64,node24-win-x64,node24-macos-x64 --output dist/nexumia-server",
    "start": "node dist/index.js",
    "test": "node --require ./test-support/isolated-config.cjs --test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "fast-glob": "3.3.3",
    "hono": "4.13.13",
    "music-metadata": "12.2.3",
    "sanitize-filename": "1.6.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@yao-pkg/pkg": "6.23.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}

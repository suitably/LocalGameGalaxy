{
    "name": "melodiq-server",
    "version": "1.0.0",
    "description": "Local server for Melodiq song library",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "package": "pkg . --out-path dist"
    },
    "bin": "index.js",
    "pkg": {
        "assets": [
            "config.js",
            "public/**/*",
            "src/**/*",
            "node_modules/**/*"
        ],
        "targets": [
            "node18-linux-x64",
            "node18-win-x64",
            "node18-macos-x64"
        ]
    },
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "fast-glob": "^3.3.2",
        "helmet": "^8.1.0",
        "morgan": "^1.10.1",
        "music-metadata": "^7.14.0",
        "node-forge": "^1.3.3",
        "sanitize-filename": "^1.6.3",
        "selfsigned": "^5.5.0"
    },
    "devDependencies": {
        "pkg": "^5.8.1"
    }
}
{
    "name": "melodiq-server",
    "version": "1.0.0",
    "description": "Local server for Melodiq song library",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "package": "pkg . --out-path dist"
    },
    "bin": "index.js",
    "pkg": {
        "scripts": "index.js",
        "assets": [],
        "targets": [
            "node18-linux-x64",
            "node18-win-x64",
            "node18-macos-x64"
        ]
    },
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "fast-glob": "^3.3.2",
        "music-metadata": "^7.14.0"
    },
    "devDependencies": {
        "pkg": "^5.8.1"
    }
}
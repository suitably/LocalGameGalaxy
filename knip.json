{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/main.tsx", "vite.config.ts", "scripts/**/*.{mjs,cjs,js}", "public/sw-push.js"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,cjs,js}"]
    },
    "server": {
      "entry": ["src/index.ts", "src/worker.ts", "cloudflare-push-relay/worker.ts", "test/**/*.test.js"],
      "project": ["src/**/*.ts", "cloudflare-push-relay/**/*.ts"]
    },
    "signaling": {
      "entry": ["src/index.js"],
      "project": ["src/**/*.js"]
    }
  },
  "ignoreDependencies": ["playwright", "esbuild", "ws", "dictionary-de", "dictionary-en"],
  "ignoreBinaries": ["ffmpeg", "cloudflared", "audio-separator", "pip3", "wget"]
}

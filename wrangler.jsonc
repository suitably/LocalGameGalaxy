{
    "name": "nexumia",
    "compatibility_date": "2026-01-19",
    // Only /api/steam/* (Steam Workshop proxy), /api/push/* (Web Push sender, secrets
    // VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY) and /api/drawpot* (draw pot API, Durable Object
    // DRAW_POTS) run the worker, see cloudflare/worker.ts; everything else is served straight
    // from the static build.
    "main": "cloudflare/worker.ts",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/steam/*", "/api/push/*", "/api/drawpot", "/api/drawpot/*"]
    },
    // One SQLite-backed Durable Object per draw pot (cloudflare/drawPot/routes.ts).
    "durable_objects": {
        "bindings": [{ "name": "DRAW_POTS", "class_name": "DrawPotObject" }]
    },
    "migrations": [{ "tag": "v1-draw-pots", "new_sqlite_classes": ["DrawPotObject"] }],
    "previews": {}
}
